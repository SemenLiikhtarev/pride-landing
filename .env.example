# Куда слать уведомления о заявках
NOTIFY_EMAIL=lsem2010@yandex.ru

# Порт сервера лендинга
PORT=8100

# Ключ для скачивания таблицы заявок с внешнего адреса:
# http://адрес-сайта/api/leads.xlsx?key=ВАШ_КЛЮЧ
# (с локального компьютера таблица скачивается и без ключа)
EXPORT_KEY=

# --- SMTP (опционально) ---
# Пока поля пустые, письма не уходят: заявки сохраняются в Excel,
# а письмо складывается в data/outbox.ndjson (заглушка).
# Как только вставите реквизиты — уведомления начнут уходить на NOTIFY_EMAIL.
#
# Пример для Яндекса (нужен пароль приложения: Яндекс ID → Пароли приложений):
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
